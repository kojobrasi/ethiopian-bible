{
  "expo": {
    "name": "Ethiopian Bible",
    "slug": "ethiopian-bible",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "ethiopianbible",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ethiopian.bible",
      "buildNumber": "1"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "backgroundColor": "#080F1C"
      },
      "package": "com.ethiopian.bible",
      "versionCode": 1
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-web-browser",
      "expo-notifications",
      [
        "react-native-google-mobile-ads",
        {
          "iosAppId": "YOUR_IOS_ADMOB_APP_ID",
          "androidAppId": "YOUR_ANDROID_ADMOB_APP_ID"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "63be9dff-4d98-4420-8f4d-e01c2d8f9d2c"
      }
    },
    "notification": {
      "icon": "./assets/images/adaptive-icon.png",
      "color": "#C0392B"
    }
  }
}
